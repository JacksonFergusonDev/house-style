---
/**
 * A hero's moving background and its pause button (css/site.css, `.hs-field`
 * and `.hs-motion`). Place it first inside `.hs-hero`. The field starts once
 * the page has loaded, so the first screen paints as text; it needs `three`
 * installed alongside house-style.
 */
import Icon from './Icon.astro';
---

<canvas class="hs-field" aria-hidden="true" data-hs-field></canvas>
<button type="button" class="hs-motion" hidden>
  <span data-hs-motion-label>Pause motion</span>
  <Icon name="pause" class="hs-motion-pause" />
  <Icon name="play" class="hs-motion-play" />
</button>

<script>
  function start() {
    const canvas = document.querySelector<HTMLCanvasElement>('[data-hs-field]');
    const button = canvas?.nextElementSibling;
    if (!canvas || !(button instanceof HTMLButtonElement)) return;
    const idle = window.requestIdleCallback ?? ((callback) => window.setTimeout(callback, 200));
    idle(() => {
      Promise.all([import('three'), import('../js/field.js')])
        .then(([three, { startField }]) => startField(three, canvas, button))
        .catch(() => {});
    });
  }
  if (document.readyState === 'complete') {
    start();
  } else {
    window.addEventListener('load', start, { once: true });
  }
</script>

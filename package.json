{
  "name": "house-style",
  "version": "1.5.0",
  "description": "Shared tokens, fonts, components, and scripts for jacksonferguson.me and its project sites",
  "license": "MIT",
  "author": "Jackson Ferguson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JacksonFergusonDev/house-style.git"
  },
  "type": "module",
  "scripts": {
    "test": "node --test",
    "test:python": "python3 -m unittest discover tests",
    "format": "prettier --write \"**/*.{js,ts,css,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{js,ts,css,json,md,yaml,yml}\"",
    "lint": "npm run lint:eslint && npm run lint:stylelint",
    "lint:eslint": "eslint .",
    "lint:stylelint": "stylelint \"css/**/*.css\""
  },
  "exports": {
    "./css/*": "./css/*",
    "./js/*": "./js/*",
    "./fonts/*": "./fonts/*",
    "./icons/*": "./icons/*",
    "./GUIDELINES.md": "./GUIDELINES.md"
  },
  "files": [
    "css",
    "js",
    "fonts",
    "icons",
    "GUIDELINES.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}

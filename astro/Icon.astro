---
/**
 * A house icon, inlined so it takes the text's colour. Icons are decoration:
 * the label beside one carries the meaning (GUIDELINES.md says which arrow a
 * link takes).
 */
const files = import.meta.glob<string>('../icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

export type IconName =
  | 'arrow-down'
  | 'arrow-left'
  | 'arrow-right'
  | 'arrow-up'
  | 'arrow-up-right'
  | 'brand-email'
  | 'brand-github'
  | 'brand-linkedin'
  | 'brand-python'
  | 'close'
  | 'collection'
  | 'github'
  | 'jacksonferguson'
  | 'mail'
  | 'pause'
  | 'play';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}
const { name, size, class: className } = Astro.props;
const file = files[`../icons/${name}.svg`];
if (!file) throw new Error(`house-style has no icon named ${name}`);
const sizing = size ? ` width="${size}" height="${size}"` : '';
const svg = file.replace(
  /<svg([^>]*)>/,
  (_, attrs: string) =>
    `<svg${attrs.replace(/\s(width|height)="[^"]*"/g, '')}${sizing} aria-hidden="true" focusable="false"${className ? ` class="${className}"` : ''}>`,
);
---

<Fragment set:html={svg} />
